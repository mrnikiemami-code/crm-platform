{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "vitest"],
  "env": {
    "browser": true,
    "es2020": true,
    "node": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-unused-vars": "error"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", ".twenty/**"]
}
